[{"updatedAt":"2026-06-25T04:28:32.701Z","createdAt":"2026-06-25T04:28:29.090Z","id":"foDJWql33xyHeOCh","name":"KM RAG LINE Chatbot","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"line-chat","responseMode":"responseNode","options":{}},"id":"webhook-node","name":"Line Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[250,300],"webhookId":"line-chat"},{"parameters":{"jsCode":"const body = $input.first().json.body || $input.first().json;\nconst events = body.events || [];\nif (!events.length) {\n  return [{ json: { userId: '', text: '' } }];\n}\nconst event = events[0];\nif (!event.message) {\n  return [{ json: { userId: '', text: '' } }];\n}\nreturn [{ json: { userId: event.source.userId, text: event.message.text } }];"},"id":"extract-data-node","name":"Extract Data","type":"n8n-nodes-base.code","typeVersion":2,"position":[450,300]},{"parameters":{"url":"http://127.0.0.1:11434/api/embeddings","method":"POST","sendBody":true,"specifyBody":"string","body":"={{ JSON.stringify({ model: 'mxbai-embed-large', prompt: $json.text }) }}","contentType":"raw","rawContentType":"application/json","options":{}},"id":"get-embedding-node","name":"Get Embedding","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[650,300]},{"parameters":{"url":"http://127.0.0.1:6333/collections/km_knowledge/points/search","method":"POST","sendBody":true,"specifyBody":"string","body":"={{ JSON.stringify({ vector: $json.embedding, limit: 5, with_payload: true }) }}","contentType":"raw","rawContentType":"application/json","options":{}},"id":"search-qdrant-node","name":"Search Qdrant","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[850,300]},{"parameters":{"jsCode":"const qdrantResult = $input.first().json;\nconst extractData = $('Extract Data').first().json;\nconst results = qdrantResult.result || [];\nlet context = '';\nfor (const r of results) {\n  if (r.payload && r.payload.text) {\n    context += r.payload.text + '\\n';\n  }\n}\nconst query = extractData.text || '';\nconst prompt = `You are a helpful assistant. Use the following context to answer the question.\\n\\nContext:\\n${context}\\n\\nQuestion: ${query}\\n\\nAnswer: `;\nreturn [{ json: { prompt, userId: extractData.userId } }];"},"id":"build-context-node","name":"Build Context","type":"n8n-nodes-base.code","typeVersion":2,"position":[1050,300]},{"parameters":{"url":"http://127.0.0.1:11434/api/generate","method":"POST","sendBody":true,"specifyBody":"string","body":"={{ JSON.stringify({ model: 'qwen3.6:latest', prompt: $json.prompt, stream: false }) }}","contentType":"raw","rawContentType":"application/json","options":{}},"id":"generate-answer-node","name":"Generate Answer","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1250,300]},{"parameters":{"url":"https://api.line.me/v2/bot/message/push","method":"POST","sendBody":true,"specifyBody":"string","body":"={{ JSON.stringify({ to: $('Build Context').first().json.userId, messages: [{ type: 'text', text: $json.response }] }) }}","contentType":"raw","rawContentType":"application/json","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.LINE_TOKEN }}"}]},"options":{}},"id":"push-to-line-node","name":"Push to LINE","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1450,300]},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify({ status: 'ok' }) }}","options":{}},"id":"respond-webhook-node","name":"Respond to Webhook","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1650,300]}],"connections":{"Line Webhook":{"main":[[{"node":"Extract Data","type":"main","index":0}]]},"Extract Data":{"main":[[{"node":"Get Embedding","type":"main","index":0}]]},"Get Embedding":{"main":[[{"node":"Search Qdrant","type":"main","index":0}]]},"Search Qdrant":{"main":[[{"node":"Build Context","type":"main","index":0}]]},"Build Context":{"main":[[{"node":"Generate Answer","type":"main","index":0}]]},"Generate Answer":{"main":[[{"node":"Push to LINE","type":"main","index":0}]]},"Push to LINE":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":null,"meta":null,"pinData":null,"versionId":"2f971d39-ca03-46cc-ac58-c8efd6cdb16b","activeVersionId":"2f971d39-ca03-46cc-ac58-c8efd6cdb16b","versionCounter":18,"triggerCount":1,"tags":[],"shared":[{"updatedAt":"2026-06-25T04:28:29.092Z","createdAt":"2026-06-25T04:28:29.092Z","role":"workflow:owner","workflowId":"foDJWql33xyHeOCh","projectId":"tZM4EC5HWM6LdZdy","project":{"updatedAt":"2026-06-25T03:57:52.773Z","createdAt":"2026-06-25T03:57:33.473Z","id":"tZM4EC5HWM6LdZdy","name":"Admin KM RAG <admin@kmrag.local>","type":"personal","icon":null,"description":null}}]}]